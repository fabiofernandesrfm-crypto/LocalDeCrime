// ============================================================================
// Schema Prisma — Sistema de Registro de Atendimento em Local de Crime (PCPE)
// Versão: 2.1.0
// Baseado em: DATABASE_ARCHITECTURE.md
// SGBD: PostgreSQL 16 + PostGIS 3.4
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ============================================================================
// ENUMS
// ============================================================================

/// Papéis básicos de usuário no sistema (RBAC complementar via Perfis/Permissões)
enum Role {
  ADMIN
  CHEFE_EQUIPE
  PERITO
  AGENTE
}

/// Status de um atendimento em local de crime
enum StatusAtendimento {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

/// Tipos de local onde ocorreu o crime
enum TipoLocal {
  RESIDENCIA
  VIA_PUBLICA
  ESTABELECIMENTO_COMERCIAL
  AREA_RURAL
  VEICULO
  OUTRO
}

/// Tipos de unidade organizacional da PCPE
enum TipoUnidade {
  DELEGACIA
  INSTITUTO
  DEPARTAMENTO
}

/// Status de uma ocorrência policial
enum StatusOcorrencia {
  ABERTA
  EM_INVESTIGACAO
  CONCLUIDA
  ARQUIVADA
}

/// Tipo de transição no histórico de status da ocorrência
enum TipoHistoricoStatus {
  FINALIZACAO
  REABERTURA
  ARQUIVAMENTO
}

/// Tipos de envolvimento de uma pessoa na ocorrência
enum TipoEnvolvimento {
  VITIMA
  TESTEMUNHA
  SUSPEITO
  NOTICIANTE
  PROPRIETARIO
  RESPONSAVEL
  OUTRO
}

/// Status da cadeia de custódia de um vestígio
enum StatusCadeia {
  COLETADO
  ACONDICIONADO
  TRANSPORTADO
  RECEBIDO
  EM_ANALISE
  ANALISADO
  DESCARTADO
  DEVOLVIDO
}

/// Tipos de equipe de atendimento
enum TipoEquipe {
  PERICIA
  INVESTIGACAO
  PLANTAO
  ESPECIAL
}

/// Status de uma equipe
enum StatusEquipe {
  ATIVA
  INATIVA
  EM_DESLOCAMENTO
  EM_ATENDIMENTO
}

/// Status de uma operação de sincronização offline
enum StatusSincronizacao {
  PENDENTE
  ENVIADO
  CONFIRMADO
  CONFLITO
  FALHA
}

/// Tipos de mídia registrados no sistema
enum TipoMidia {
  FOTO
  VIDEO
  AUDIO
  DOCUMENTO
}

/// Níveis de severidade para logs do sistema
enum NivelLog {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

/// Ações registradas na auditoria do sistema
enum AcaoAuditoria {
  CRIAR
  ATUALIZAR
  DELETAR
  VISUALIZAR
  EXPORTAR
  LOGIN
  LOGOUT
  FALHA_LOGIN
}

/// Tipos de assinatura digital aceitos
enum TipoAssinatura {
  BIOMETRICA
  CERTIFICADO_DIGITAL
  PIN
  SENHA
}

/// Status de uma sessão de usuário
enum StatusSessao {
  ATIVA
  EXPIRADA
  REVOGADA
}

/// Tipos de acondicionamento de vestígios
enum TipoAcondicionamento {
  SACO_PLASTICO
  ENVELOPE_PAPEL
  CAIXA_PAPELAO
  TUBO_ENSAIO
  FRASCO_VIDRO
  LACRE_METALICO
}

/// Categorias de objetos apreendidos
enum CategoriaObjeto {
  ELETRONICO
  DOCUMENTO
  JOIA
  FERRAMENTA
  VESTUARIO
  OUTRO
}

/// Tipos de armas
enum TipoArma {
  REVOLVER
  PISTOLA
  ESPINGARDA
  FUZIL
  FACA
  FACAO
  OUTRA_BRANCA
  OUTRA_FOGO
}

/// Tipos de munição por calibre
enum TipoMunicao {
  CALIBRE_22
  CALIBRE_38
  CALIBRE_380
  CALIBRE_9MM
  CALIBRE_12
  CALIBRE_556
  CALIBRE_762
  OUTRO
}

/// Tipos de drogas/entorpecentes
enum TipoDroga {
  MACONHA
  COCAINA
  CRACK
  HEROINA
  LSD
  ECSTASY
  METANFETAMINA
  OUTRA
}

/// Métodos de autenticação suportados
enum MetodoAutenticacao {
  SENHA
  BIOMETRIA
  CERTIFICADO
  SSO
}

/// Sexo para cadastro de pessoas envolvidas
enum Sexo {
  MASCULINO
  FEMININO
  NAO_INFORMADO
}

/// Tipo de pessoa (física ou jurídica)
enum TipoPessoa {
  FISICA
  JURIDICA
}

/// Status de processamento de uma mídia
enum StatusProcessamentoMidia {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHA
}

/// Função de um usuário dentro de uma equipe
enum FuncaoEquipe {
  CHEFE
  PERITO
  AGENTE
  FOTOGRAFO
  MOTORISTA
  AUXILIAR
}

// ============================================================================
// DOMÍNIO 1: AUTENTICAÇÃO E GESTÃO DE USUÁRIOS
// ============================================================================

/// Histórico imutável de transições de status da Ocorrência (append-only).
/// Sem PATCH. Sem DELETE.
model HistoricoStatusOcorrencia {
  id             String                @id @default(uuid())
  tipo           TipoHistoricoStatus
  statusAnterior StatusOcorrencia      @map("status_anterior")
  statusNovo     StatusOcorrencia      @map("status_novo")
  motivo         String?
  alteradoEm     DateTime              @default(now()) @map("alterado_em")
  criadoEm       DateTime              @default(now()) @map("criado_em")

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  alteradoPorId String  @map("alterado_por_id")
  alteradoPor   Usuario @relation(fields: [alteradoPorId], references: [id])

  @@index([ocorrenciaId])
  @@index([alteradoPorId])
  @@index([alteradoEm])
  @@map("historico_status_ocorrencia")
}

/// Usuário do sistema — policiais e servidores com acesso
model Usuario {
  id           String    @id @default(uuid())
  matricula    String    @unique
  nome         String
  email        String    @unique
  senha        String
  cargo        String?
  role         Role      @default(AGENTE)
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  // Relacionamentos organizacionais
  unidadeId String?  @map("unidade_id")
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  // Relacionamentos com outras entidades
  atendimentosLocais     AtendimentoLocal[]
  ocorrencias            Ocorrencia[]
  sessoes                Sessao[]
  usuarioPerfis          UsuarioPerfil[]
  equipeUsuarios         EquipeUsuario[]
  assinaturas            Assinatura[]
  auditorias             Auditoria[]
  historicosAlteracao    HistoricoAlteracao[]
  linhasTempo            LinhaTempo[]
  dispositivos           Dispositivo[]
  filaSincronizacao      FilaSincronizacao[]
  fotografias            Fotografia[]
  videos                 Video[]
  audios                 Audio[]
  documentosAnexos       DocumentoAnexo[]
  cadeiasCustodia        CadeiaCustodia[]
  backupsRegistro        BackupRegistro[]
  logsSistema            LogSistema[]
  policiaisParticipantes PolicialParticipante[]
  veiculosOcorrencia     VeiculoOcorrencia[]
  objetosOcorrencia      ObjetoOcorrencia[]
  vestigiosOcorrencia    VestigioOcorrencia[]
  movimentacoesCustodia  MovimentacaoCustodiaVestigio[]
  fotografiasOcorrencia  FotografiaOcorrencia[]
  anexosOcorrencia       AnexoOcorrencia[]
  ocorrenciasFinalizadas       Ocorrencia[]                    @relation("OcorrenciaFinalizadaPor")
  alteracoesStatusOcorrencia   HistoricoStatusOcorrencia[]

  @@index([unidadeId])
  @@index([ativo])
  @@index([deletadoEm])
  @@map("usuarios")
}

/// Perfil — conjunto de permissões atribuíveis a usuários (RBAC)
model Perfil {
  id           String    @id @default(uuid())
  nome         String    @unique
  descricao    String?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  usuarioPerfis    UsuarioPerfil[]
  perfilPermissoes PerfilPermissao[]

  @@index([deletadoEm])
  @@map("perfis")
}

/// Permissão atômica do sistema (ex: criar_atendimento, ver_relatorio)
model Permissao {
  id           String    @id @default(uuid())
  codigo       String    @unique
  descricao    String?
  modulo       String
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  perfilPermissoes PerfilPermissao[]

  @@index([modulo])
  @@index([deletadoEm])
  @@map("permissoes")
}

/// Tabela associativa N:N entre Usuario e Perfil
model UsuarioPerfil {
  usuarioId String   @map("usuario_id")
  perfilId  String   @map("perfil_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([usuarioId, perfilId])
  @@map("usuario_perfis")
}

/// Tabela associativa N:N entre Perfil e Permissao
model PerfilPermissao {
  perfilId    String   @map("perfil_id")
  permissaoId String   @map("permissao_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissaoId])
  @@map("perfil_permissoes")
}

/// Sessão ativa de um usuário (login)
model Sessao {
  id            String       @id @default(uuid())
  token         String       @unique
  status        StatusSessao @default(ATIVA)
  ipOrigem      String?      @map("ip_origem")
  userAgent     String?      @map("user_agent")
  dispositivoId String?      @map("dispositivo_id")
  criadoEm      DateTime     @default(now()) @map("criado_em")
  expiradoEm    DateTime?    @map("expirado_em")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@index([usuarioId])
  @@index([status])
  @@map("sessoes")
}

/// Refresh token para renovação de access token JWT
model RefreshToken {
  id       String   @id @default(uuid())
  token    String   @unique
  expiraEm DateTime @map("expira_em")
  criadoEm DateTime @default(now()) @map("criado_em")
  revogado Boolean  @default(false)

  sessaoId String @map("sessao_id")
  sessao   Sessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@index([revogado])
  @@map("refresh_tokens")
}

// ============================================================================
// DOMÍNIO 2: ESTRUTURA ORGANIZACIONAL
// ============================================================================

/// Unidade — tabela supertype que unifica Delegacia, Instituto e Departamento
model Unidade {
  id           String      @id @default(uuid())
  nome         String
  sigla        String?
  tipo         TipoUnidade
  endereco     String?
  bairro       String?
  cep          String?
  telefone     String?
  email        String?
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")
  deletadoEm   DateTime?   @map("deletado_em")

  municipioId String    @map("municipio_id")
  municipio   Municipio @relation(fields: [municipioId], references: [id])

  delegacia    Delegacia?
  instituto    Instituto?
  departamento Departamento?
  usuarios     Usuario[]
  equipes      Equipe[]

  @@index([municipioId])
  @@index([tipo])
  @@index([deletadoEm])
  @@map("unidades")
}

/// Delegacia — unidade territorial da Polícia Civil
model Delegacia {
  id            String    @id @default(uuid())
  circunscricao String?
  titulo        String?
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")
  deletadoEm    DateTime? @map("deletado_em")

  unidadeId String  @unique @map("unidade_id")
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  ocorrencias Ocorrencia[]

  @@index([deletadoEm])
  @@map("delegacias")
}

/// Instituto — unidade pericial (IML, IC, IITB, etc.)
model Instituto {
  id            String    @id @default(uuid())
  especialidade String?
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")
  deletadoEm    DateTime? @map("deletado_em")

  unidadeId String  @unique @map("unidade_id")
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([deletadoEm])
  @@map("institutos")
}

/// Departamento — unidade administrativa/especializada (DHPP, DPM, etc.)
model Departamento {
  id           String    @id @default(uuid())
  sigla        String?
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  unidadeId String  @unique @map("unidade_id")
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([deletadoEm])
  @@map("departamentos")
}

/// Município de Pernambuco — tabela de domínio para endereçamento
model Municipio {
  id         String   @id @default(uuid())
  nome       String
  uf         String   @default("PE")
  codigoIbge String?  @unique @map("codigo_ibge")
  criadoEm   DateTime @default(now()) @map("criado_em")

  unidades          Unidade[]
  ocorrencias       Ocorrencia[]
  pessoasEnvolvidas PessoaEnvolvida[]

  @@index([nome])
  @@index([uf])
  @@map("municipios")
}

// ============================================================================
// DOMÍNIO 3: OCORRÊNCIAS E ATENDIMENTOS
// ============================================================================

/// Ocorrência policial — registro formal (equivalente ao BO)
model Ocorrencia {
  id             String           @id @default(uuid())
  numeroBo       String           @unique @map("numero_bo")
  status         StatusOcorrencia @default(ABERTA)
  dataOcorrencia DateTime         @default(now()) @map("data_ocorrencia")
  dataConclusao  DateTime?        @map("data_conclusao")
  descricao      String
  observacoes             String?
  observacoesEncerramento String?  @map("observacoes_encerramento")
  finalizadaPorId         String?  @map("finalizada_por_id")
  finalizadaPor           Usuario? @relation("OcorrenciaFinalizadaPor", fields: [finalizadaPorId], references: [id])
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")
  deletadoEm     DateTime?        @map("deletado_em")

  municipioId String    @map("municipio_id")
  municipio   Municipio @relation(fields: [municipioId], references: [id])

  delegaciaId String    @map("delegacia_id")
  delegacia   Delegacia @relation(fields: [delegaciaId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  atendimentosLocais AtendimentoLocal[]
  pessoasEnvolvidas     PessoaEnvolvida[]
  linhasTempo           LinhaTempo[]
  veiculosOcorrencia    VeiculoOcorrencia[]
  objetosOcorrencia     ObjetoOcorrencia[]
  vestigiosOcorrencia   VestigioOcorrencia[]
  fotografiasOcorrencia FotografiaOcorrencia[]
  anexosOcorrencia      AnexoOcorrencia[]
  historicoStatus        HistoricoStatusOcorrencia[]

  @@index([numeroBo])
  @@index([municipioId])
  @@index([delegaciaId])
  @@index([usuarioId])
  @@index([status])
  @@index([dataOcorrencia])
  @@index([deletadoEm])
  @@map("ocorrencias")
}

/// Atendimento pericial em local de crime (sucede o modelo Atendimento original)
model AtendimentoLocal {
  id             String            @id @default(uuid())
  numeroRegistro Int               @unique @default(autoincrement()) @map("numero_registro")
  status         StatusAtendimento @default(ABERTO)
  tipoLocal      TipoLocal         @map("tipo_local")
  endereco       String
  numero         String?
  complemento    String?
  bairro         String
  cidade         String
  estado         String            @default("PE")
  cep            String?
  latitude       Float?
  longitude      Float?
  descricao      String
  observacoes    String?
  dataOcorrencia DateTime          @default(now()) @map("data_ocorrencia")
  dataConclusao  DateTime?         @map("data_conclusao")
  criadoEm       DateTime          @default(now()) @map("criado_em")
  atualizadoEm   DateTime          @updatedAt @map("atualizado_em")
  deletadoEm     DateTime?         @map("deletado_em")
  versao         Int               @default(1)

  // Relacionamentos principais
  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  equipeId String? @map("equipe_id")
  equipe   Equipe? @relation(fields: [equipeId], references: [id])

  // Subcoleções do atendimento
  vestigios              Vestigio[]
  objetos                Objeto[]
  armas                  Arma[]
  municoes               Municao[]
  drogas                 Droga[]
  veiculos               Veiculo[]
  fotografias            Fotografia[]
  videos                 Video[]
  audios                 Audio[]
  documentosAnexos       DocumentoAnexo[]
  policiaisParticipantes PolicialParticipante[]
  assinaturas            Assinatura[]
  linhasTempo            LinhaTempo[]
  historicosAlteracao    HistoricoAlteracao[]

  @@index([numeroRegistro])
  @@index([ocorrenciaId])
  @@index([equipeId])
  @@index([usuarioId])
  @@index([status])
  @@index([dataOcorrencia])
  @@index([deletadoEm])
  @@map("atendimentos_local")
}

// ============================================================================
// DOMÍNIO 4: EQUIPES E PESSOAL
// ============================================================================

/// Equipe de atendimento — grupo de policiais/peritos
model Equipe {
  id           String       @id @default(uuid())
  nome         String
  tipo         TipoEquipe
  status       StatusEquipe @default(ATIVA)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")
  deletadoEm   DateTime?    @map("deletado_em")

  unidadeId String  @map("unidade_id")
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  equipeUsuarios     EquipeUsuario[]
  atendimentosLocais AtendimentoLocal[]

  @@index([unidadeId])
  @@index([tipo])
  @@index([status])
  @@index([deletadoEm])
  @@map("equipes")
}

/// Tabela associativa N:N entre Equipe e Usuario com função na equipe
model EquipeUsuario {
  equipeId  String       @map("equipe_id")
  usuarioId String       @map("usuario_id")
  funcao    FuncaoEquipe @default(AGENTE)
  criadoEm  DateTime     @default(now()) @map("criado_em")

  equipe  Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([equipeId, usuarioId])
  @@index([usuarioId])
  @@map("equipe_usuarios")
}

/// Pessoa envolvida na ocorrência (vítima, testemunha, suspeito, etc.)
model PessoaEnvolvida {
  id               String           @id @default(uuid())
  nome             String?
  identificada     Boolean          @default(true)
  nic              String?
  cpf              String?
  rg               String?
  sexo             Sexo             @default(NAO_INFORMADO)
  dataNascimento   DateTime?        @map("data_nascimento")
  telefone         String?
  endereco         String?
  bairro           String?
  cep              String?
  tipoEnvolvimento TipoEnvolvimento @map("tipo_envolvimento")
  depoimento       String?
  criadoEm         DateTime         @default(now()) @map("criado_em")
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em")
  deletadoEm       DateTime?        @map("deletado_em")

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  municipioId String?    @map("municipio_id")
  municipio   Municipio? @relation(fields: [municipioId], references: [id])

  @@index([ocorrenciaId])
  @@index([cpf])
  @@index([municipioId])
  @@index([tipoEnvolvimento])
  // relações 1:N
  telefonesPessoa TelefonePessoa[]
  enderecosPessoa EnderecoPessoa[]
  objetosOcorrencia ObjetoOcorrencia[]
  fotografiasOcorrencia FotografiaOcorrencia[]
  anexosOcorrencia      AnexoOcorrencia[]

  @@index([deletadoEm])
  @@map("pessoas_envolvidas")
}

/// Telefone 1:N vinculado a uma PessoaEnvolvida
model TelefonePessoa {
  id        String   @id @default(uuid())
  numero    String
  tipo      String?
  observacao String?
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  pessoaId        String          @map("pessoa_id")
  pessoaEnvolvida PessoaEnvolvida @relation(fields: [pessoaId], references: [id])

  @@index([pessoaId])
  @@map("telefones_pessoa")
}

/// Endereço 1:N vinculado a uma PessoaEnvolvida
model EnderecoPessoa {
  id          String   @id @default(uuid())
  logradouro  String
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  tipo        String?
  observacao  String?
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  pessoaId        String          @map("pessoa_id")
  pessoaEnvolvida PessoaEnvolvida @relation(fields: [pessoaId], references: [id])

  @@index([pessoaId])
  @@map("enderecos_pessoa")
}

/// Policial participante do atendimento (além da equipe formal)
model PolicialParticipante {
  id          String   @id @default(uuid())
  nome        String
  matricula   String?
  instituicao String?
  funcao      String?
  criadoEm    DateTime @default(now()) @map("criado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([atendimentoLocalId])
  @@index([usuarioId])
  @@map("policiais_participantes")
}

// ============================================================================
// DOMÍNIO 5: VESTÍGIOS E CADEIA DE CUSTÓDIA
// ============================================================================

/// Classificação de tipos de vestígio (biológico, químico, balístico, etc.)
model TipoVestigio {
  id           String    @id @default(uuid())
  nome         String    @unique
  descricao    String?
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  vestigios Vestigio[]

  @@index([deletadoEm])
  @@map("tipos_vestigio")
}

/// Registro de acondicionamento de vestígio (embalagem, lacre)
model Acondicionamento {
  id          String               @id @default(uuid())
  tipo        TipoAcondicionamento
  numeroLacre String?              @map("numero_lacre")
  descricao   String?
  criadoEm    DateTime             @default(now()) @map("criado_em")

  vestigios Vestigio[]

  @@map("acondicionamentos")
}

/// Destino possível de um vestígio na cadeia de custódia
model DestinoVestigio {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  cadeiasCustodia CadeiaCustodia[]

  @@map("destinos_vestigio")
}

/// Vestígio coletado no local de crime
model Vestigio {
  id             String    @id @default(uuid())
  numeroCustodia String    @unique @map("numero_custodia")
  descricao      String
  quantidade     Int       @default(1)
  localColeta    String?   @map("local_coleta")
  observacoes    String?
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")
  deletadoEm     DateTime? @map("deletado_em")
  versao         Int       @default(1)

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  tipoVestigioId String       @map("tipo_vestigio_id")
  tipoVestigio   TipoVestigio @relation(fields: [tipoVestigioId], references: [id])

  acondicionamentoId String?           @map("acondicionamento_id")
  acondicionamento   Acondicionamento? @relation(fields: [acondicionamentoId], references: [id])

  cadeiasCustodia CadeiaCustodia[]
  fotografias     Fotografia[]

  @@index([atendimentoLocalId])
  @@index([tipoVestigioId])
  @@index([acondicionamentoId])
  @@index([numeroCustodia])
  @@index([deletadoEm])
  @@map("vestigios")
}

/// Registro da cadeia de custódia — cada movimentação de um vestígio (append-only)
model CadeiaCustodia {
  id          String       @id @default(uuid())
  status      StatusCadeia
  descricao   String
  observacoes String?
  dataHora    DateTime     @default(now()) @map("data_hora")
  criadoEm    DateTime     @default(now()) @map("criado_em")

  vestigioId String   @map("vestigio_id")
  vestigio   Vestigio @relation(fields: [vestigioId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  destinoVestigioId String?          @map("destino_vestigio_id")
  destinoVestigio   DestinoVestigio? @relation(fields: [destinoVestigioId], references: [id])

  assinaturas Assinatura[]

  @@index([vestigioId])
  @@index([usuarioId])
  @@index([dataHora])
  @@index([status])
  @@map("cadeia_custodia")
}

// ============================================================================
// DOMÍNIO 6: OBJETOS E ITENS APREENDIDOS
// ============================================================================

/// Categoria de objeto apreendido
model CategoriaObjetoModel {
