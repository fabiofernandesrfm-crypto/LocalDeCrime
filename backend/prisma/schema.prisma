  quantidade   Int       @default(1)
  marca        String?
  lote         String?
  observacoes  String?
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  tipoMunicaoId String           @map("tipo_municao_id")
  tipoMunicao   TipoMunicaoModel @relation(fields: [tipoMunicaoId], references: [id])

