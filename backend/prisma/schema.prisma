}

/// Tipo de droga para classificação
model TipoDrogaModel {
  id           String    @id @default(uuid())
  nome         String    @unique
  descricao    String?
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  drogas Droga[]

  @@index([deletadoEm])
  @@map("tipos_droga")
}

/// Droga/entorpecente apreendido no local de crime
model Droga {
  id             String    @id @default(uuid())
  pesoGramas     Float?    @map("peso_gramas")
  unidadeMedida  String?   @map("unidade_medida")
  apresentacao   String?
  purezaEstimada String?   @map("pureza_estimada")
  observacoes    String?
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")
  deletadoEm     DateTime? @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  tipoDrogaId String         @map("tipo_droga_id")
  tipoDroga   TipoDrogaModel @relation(fields: [tipoDrogaId], references: [id])

  fotografias Fotografia[]

  @@index([atendimentoLocalId])
  @@index([tipoDrogaId])
  @@index([deletadoEm])
  @@map("drogas")
}

/// Veículo relacionado à ocorrência
model Veiculo {
  id            String    @id @default(uuid())
  placa         String?
  chassi        String?
  renavam       String?
  marca         String?
  modelo        String?
  cor           String?
  anoFabricacao Int?      @map("ano_fabricacao")
  anoModelo     Int?      @map("ano_modelo")
  observacoes   String?
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")
  deletadoEm    DateTime? @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  fotografias Fotografia[]

  @@index([atendimentoLocalId])
  @@index([placa])
  @@index([chassi])
  @@index([deletadoEm])
  @@map("veiculos")
}

/// Objeto vinculado diretamente à Ocorrência — fluxo do Usuário de Campo (Elementos do Fato).
///
/// DIFERENÇA para o model Objeto (legado):
///   - Objeto           → vinculado a AtendimentoLocal (legado, categoria/fotos)
///   - ObjetoOcorrencia → vinculado diretamente a Ocorrencia com coleta/destinação
model ObjetoOcorrencia {
  id              String   @id @default(uuid())
  categoria       String?  /// tipo/categoria do objeto
  descricao       String?
  marca           String?
  modelo          String?
  numeroSerie     String?  @map("numero_serie")
  quantidade      Int      @default(1)
  caracteristicas String?
  situacao        String?
  destinacao      String?
  coletadoPor     String?  @map("coletado_por")  /// responsável físico pela coleta (campo de negócio)
  destinatario    String?
  docDestinatario String?  @map("doc_destinatario")
  vinculoDest     String?  @map("vinculo_dest")
  gpsLat          Float?   @map("gps_lat")
  gpsLng          Float?   @map("gps_lng")
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  criadoPorId String  @map("criado_por_id")
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  pessoaId String?          @map("pessoa_id")
  pessoa   PessoaEnvolvida? @relation(fields: [pessoaId], references: [id])

  fotografiasOcorrencia FotografiaOcorrencia[]
  anexosOcorrencia      AnexoOcorrencia[]

  @@index([ocorrenciaId])
  @@index([criadoPorId])
  @@index([pessoaId])
  @@map("objetos_ocorrencia")
}

/// Vestígio vinculado diretamente à Ocorrência — fluxo do Usuário de Campo (Elementos do Fato).
///
/// DIFERENÇA para o model Vestigio (legado):
///   - Vestigio           → vinculado a AtendimentoLocal (legado, cadeia de custódia, lacres)
///   - VestigioOcorrencia → vinculado diretamente a Ocorrencia com coleta/localização básica
model VestigioOcorrencia {
  id                   String   @id @default(uuid())
  categoria            String?  /// tipo/categoria do vestigio
  descricao            String?
  caracteristicas      String?
  localizacaoDescricao String?  @map("localizacao_descricao")
  gpsLat               Float?   @map("gps_lat")
  gpsLng               Float?   @map("gps_lng")
  coletado             Boolean  @default(false)
  coletadoPor          String?  @map("coletado_por")  /// responsável físico pela coleta
  situacao             String?
  destinacao           String?
  observacoes          String?
  // Acondicionamento + Lacre
  acondicionado         Boolean   @default(false)
  tipoAcondicionamento  String?   @map("tipo_acondicionamento")
  descricaoAcondicionamento String? @map("descricao_acondicionamento")
  acondicionadoPor      String?   @map("acondicionado_por")
  acondicionadoEm       DateTime? @map("acondicionado_em")
  numeroLacre           String?   @map("numero_lacre")
  tipoLacre             String?   @map("tipo_lacre")
  lacradoPor            String?   @map("lacrado_por")
  lacradoEm             DateTime? @map("lacrado_em")
  criadoEm             DateTime @default(now()) @map("criado_em")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  criadoPorId String  @map("criado_por_id")
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  movimentacoesCustodia MovimentacaoCustodiaVestigio[]
  fotografiasOcorrencia FotografiaOcorrencia[]
  anexosOcorrencia      AnexoOcorrencia[]

  @@index([ocorrenciaId])
  @@index([criadoPorId])
  @@map("vestigios_ocorrencia")
}

/// Movimentação da cadeia de custódia de um VestigioOcorrencia (histórico imutável).
/// Sem PATCH/DELETE — correções futuras serão por nova movimentação de retificação.
model MovimentacaoCustodiaVestigio {
  id               String   @id @default(uuid())
  tipoMovimentacao String   @map("tipo_movimentacao")
  origem           String?
  destino          String?
  entreguePor      String?  @map("entregue_por")
  recebidoPor      String?  @map("recebido_por")
  documentoRecebedor String? @map("documento_recebedor")
  observacoes      String?
  movimentadoEm    DateTime @default(now()) @map("movimentado_em")  /// data/hora do evento físico
  criadoEm         DateTime @default(now()) @map("criado_em")       /// data/hora do registro no sistema

  vestigioId String             @map("vestigio_id")
  vestigio   VestigioOcorrencia @relation(fields: [vestigioId], references: [id])

  registradoPorId String  @map("registrado_por_id")
  registradoPor   Usuario @relation(fields: [registradoPorId], references: [id])

  @@index([vestigioId])
  @@index([registradoPorId])
  @@index([movimentadoEm])
  @@map("movimentacoes_custodia_vestigio")
}

/// Fotografia vinculada diretamente à Ocorrência — fluxo do Usuário de Campo.
/// Vínculo opcional a PessoaEnvolvida, VeiculoOcorrencia, ObjetoOcorrencia ou VestigioOcorrencia.
/// Apenas UM vínculo específico por foto (exclusivo).
model FotografiaOcorrencia {
  id                String   @id @default(uuid())
  storageKey        String   @map("storage_key")
  arquivoOriginalNome String  @map("arquivo_original_nome")
  mimeType          String   @map("mime_type")
  tamanhoBytes      Int      @map("tamanho_bytes")
  legenda           String?
  ordem             Int      @default(0)
  capturadoEm       DateTime? @map("capturado_em")
  gpsLat            Float?   @map("gps_lat")
  gpsLng            Float?   @map("gps_lng")
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  criadoPorId String  @map("criado_por_id")
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  // FKs opcionais (apenas UM deve ser preenchido)
  pessoaId  String?          @map("pessoa_id")
  pessoa    PessoaEnvolvida? @relation(fields: [pessoaId], references: [id])
  veiculoId String?          @map("veiculo_id")
  veiculo   VeiculoOcorrencia? @relation(fields: [veiculoId], references: [id])
  objetoId  String?          @map("objeto_id")
  objeto    ObjetoOcorrencia?  @relation(fields: [objetoId], references: [id])
  vestigioId String?         @map("vestigio_id")
  vestigio   VestigioOcorrencia? @relation(fields: [vestigioId], references: [id])

  @@index([ocorrenciaId])
  @@index([criadoPorId])
  @@index([pessoaId])
  @@index([veiculoId])
  @@index([objetoId])
  @@index([vestigioId])
  @@map("fotografias_ocorrencia")
}

/// Anexo / Documento vinculado diretamente à Ocorrência.
/// Vínculo opcional a PessoaEnvolvida, VeiculoOcorrencia, ObjetoOcorrencia ou VestigioOcorrencia.
/// Apenas UM vínculo específico por anexo (exclusivo).
model AnexoOcorrencia {
  id                  String   @id @default(uuid())
  storageKey          String   @map("storage_key")
  arquivoOriginalNome String   @map("arquivo_original_nome")
  mimeType            String   @map("mime_type")
  tamanhoBytes        Int      @map("tamanho_bytes")
  categoria           String?
  descricao           String?
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  criadoPorId String  @map("criado_por_id")
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  pessoaId  String?          @map("pessoa_id")
  pessoa    PessoaEnvolvida? @relation(fields: [pessoaId], references: [id])
  veiculoId String?          @map("veiculo_id")
  veiculo   VeiculoOcorrencia? @relation(fields: [veiculoId], references: [id])
  objetoId  String?          @map("objeto_id")
  objeto    ObjetoOcorrencia?  @relation(fields: [objetoId], references: [id])
  vestigioId String?         @map("vestigio_id")
  vestigio   VestigioOcorrencia? @relation(fields: [vestigioId], references: [id])

  @@index([ocorrenciaId])
  @@index([criadoPorId])
  @@map("anexos_ocorrencia")
}

/// Veículo vinculado diretamente à Ocorrência — fluxo do Usuário de Campo.
///
/// DIFERENÇA para o model Veiculo (legado):
///   - Veiculo         → vinculado a AtendimentoLocal (legado)
///   - VeiculoOcorrencia → vinculado diretamente a Ocorrencia (Elementos do Fato)
///
/// Ambos coexistem. VeiculoOcorrencia é o model oficial deste fluxo.
model VeiculoOcorrencia {
  id              String   @id @default(uuid())
  placa           String?
  marca           String?
  modelo          String?
  ano             String?
  cor             String?
  situacao        String?
  destinacao      String?
  responsavel     String?  /// responsável operacional pelo recolhimento (campo de negócio)
  destinatario    String?
  docDestinatario String?  @map("doc_destinatario")
  vinculo         String?
  gpsLat          Float?   @map("gps_lat")
  gpsLng          Float?   @map("gps_lng")
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  // Autoria do registro (quem cadastrou no sistema)
  criadoPorId String  @map("criado_por_id")
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  fotografiasOcorrencia FotografiaOcorrencia[]
  anexosOcorrencia      AnexoOcorrencia[]

  @@index([ocorrenciaId])
  @@index([placa])
  @@index([criadoPorId])
  @@map("veiculos_ocorrencia")
}

// ============================================================================
// DOMÍNIO 7: MÍDIAS (FOTOGRAFIAS, VÍDEOS, ÁUDIOS, DOCUMENTOS)
// ============================================================================

/// Tag para categorização de mídias
model MidiaTag {
  id           String    @id @default(uuid())
  nome         String    @unique
  cor          String?
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  deletadoEm   DateTime? @map("deletado_em")

  midiaMidiaTags MidiaMidiaTag[]

  @@index([deletadoEm])
  @@map("midia_tags")
}

/// Tabela associativa N:N entre mídias e tags (polimórfica)
model MidiaMidiaTag {
  id         String   @id @default(uuid())
  midiaTagId String   @map("midia_tag_id")
  midiaTag   MidiaTag @relation(fields: [midiaTagId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now()) @map("criado_em")

  // FKs opcionais — exatamente uma deve ser preenchida (validar via CHECK constraint ou aplicação)
  fotografiaId     String?         @map("fotografia_id")
  fotografia       Fotografia?     @relation(fields: [fotografiaId], references: [id], onDelete: Cascade)
  videoId          String?         @map("video_id")
  video            Video?          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  audioId          String?         @map("audio_id")
  audio            Audio?          @relation(fields: [audioId], references: [id], onDelete: Cascade)
  documentoAnexoId String?         @map("documento_anexo_id")
  documentoAnexo   DocumentoAnexo? @relation(fields: [documentoAnexoId], references: [id], onDelete: Cascade)

  @@index([midiaTagId])
  @@index([fotografiaId])
  @@index([videoId])
  @@index([audioId])
  @@index([documentoAnexoId])
  @@map("midia_midia_tags")
}

/// Fotografia registrada no atendimento
model Fotografia {
  id                  String                   @id @default(uuid())
  arquivoUrl          String                   @map("arquivo_url")
  thumbnailUrl        String?                  @map("thumbnail_url")
  descricao           String?
  resolucao           String?
  tamanhoBytes        Int?                     @map("tamanho_bytes")
  formato             String?
  coordenadas         Json?
  dataHora            DateTime                 @default(now()) @map("data_hora")
  statusProcessamento StatusProcessamentoMidia @default(PENDENTE) @map("status_processamento")
  criadoEm            DateTime                 @default(now()) @map("criado_em")
  atualizadoEm        DateTime                 @updatedAt @map("atualizado_em")
  deletadoEm          DateTime?                @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // FKs opcionais para entidades relacionadas
  vestigioId String?   @map("vestigio_id")
  vestigio   Vestigio? @relation(fields: [vestigioId], references: [id])
  objetoId   String?   @map("objeto_id")
  objeto     Objeto?   @relation(fields: [objetoId], references: [id])
  armaId     String?   @map("arma_id")
  arma       Arma?     @relation(fields: [armaId], references: [id])
  municaoId  String?   @map("municao_id")
  municao    Municao?  @relation(fields: [municaoId], references: [id])
  drogaId    String?   @map("droga_id")
  droga      Droga?    @relation(fields: [drogaId], references: [id])
  veiculoId  String?   @map("veiculo_id")
  veiculo    Veiculo?  @relation(fields: [veiculoId], references: [id])

  midiaMidiaTags MidiaMidiaTag[]

  @@index([atendimentoLocalId])
  @@index([usuarioId])
  @@index([vestigioId])
  @@index([objetoId])
  @@index([armaId])
  @@index([municaoId])
  @@index([drogaId])
  @@index([veiculoId])
  @@index([deletadoEm])
  @@map("fotografias")
}

/// Vídeo registrado no atendimento
model Video {
  id                  String                   @id @default(uuid())
  arquivoUrl          String                   @map("arquivo_url")
  thumbnailUrl        String?                  @map("thumbnail_url")
  descricao           String?
  duracaoSegundos     Int?                     @map("duracao_segundos")
  resolucao           String?
  tamanhoBytes        Int?                     @map("tamanho_bytes")
  formato             String?
  statusProcessamento StatusProcessamentoMidia @default(PENDENTE) @map("status_processamento")
  criadoEm            DateTime                 @default(now()) @map("criado_em")
  atualizadoEm        DateTime                 @updatedAt @map("atualizado_em")
  deletadoEm          DateTime?                @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  midiaMidiaTags MidiaMidiaTag[]

  @@index([atendimentoLocalId])
  @@index([usuarioId])
  @@index([deletadoEm])
  @@map("videos")
}

/// Áudio registrado no atendimento
model Audio {
  id                  String                   @id @default(uuid())
  arquivoUrl          String                   @map("arquivo_url")
  descricao           String?
  duracaoSegundos     Int?                     @map("duracao_segundos")
  tamanhoBytes        Int?                     @map("tamanho_bytes")
  formato             String?
  transcricao         String?
  statusProcessamento StatusProcessamentoMidia @default(PENDENTE) @map("status_processamento")
  criadoEm            DateTime                 @default(now()) @map("criado_em")
  atualizadoEm        DateTime                 @updatedAt @map("atualizado_em")
  deletadoEm          DateTime?                @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  midiaMidiaTags MidiaMidiaTag[]

  @@index([atendimentoLocalId])
  @@index([usuarioId])
  @@index([deletadoEm])
  @@map("audios")
}

/// Documento digitalizado anexado ao atendimento
model DocumentoAnexo {
  id                  String                   @id @default(uuid())
  arquivoUrl          String                   @map("arquivo_url")
  titulo              String
  descricao           String?
  tipoDocumento       String?                  @map("tipo_documento")
  tamanhoBytes        Int?                     @map("tamanho_bytes")
  formato             String?
  numPaginas          Int?                     @map("num_paginas")
  statusProcessamento StatusProcessamentoMidia @default(PENDENTE) @map("status_processamento")
  criadoEm            DateTime                 @default(now()) @map("criado_em")
  atualizadoEm        DateTime                 @updatedAt @map("atualizado_em")
  deletadoEm          DateTime?                @map("deletado_em")

  atendimentoLocalId String           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal @relation(fields: [atendimentoLocalId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  midiaMidiaTags MidiaMidiaTag[]
  assinaturas    Assinatura[]

  @@index([atendimentoLocalId])
  @@index([usuarioId])
  @@index([deletadoEm])
  @@map("documentos_anexos")
}

// ============================================================================
// DOMÍNIO 8: ASSINATURAS E VALIDAÇÃO
// ============================================================================

/// Tipo de assinatura digital
model TipoAssinaturaModel {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  assinaturas Assinatura[]

  @@map("tipos_assinatura")
}

/// Assinatura digital de um registro (validação jurídica)
model Assinatura {
  id       String   @id @default(uuid())
  hash     String
  dados    Json?
  dataHora DateTime @default(now()) @map("data_hora")
  ipOrigem String?  @map("ip_origem")
  criadoEm DateTime @default(now()) @map("criado_em")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipoAssinaturaId String              @map("tipo_assinatura_id")
  tipoAssinatura   TipoAssinaturaModel @relation(fields: [tipoAssinaturaId], references: [id])

  // FKs opcionais para o objeto assinado
  atendimentoLocalId String?           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal? @relation(fields: [atendimentoLocalId], references: [id])
  cadeiaCustodiaId   String?           @map("cadeia_custodia_id")
  cadeiaCustodia     CadeiaCustodia?   @relation(fields: [cadeiaCustodiaId], references: [id])
  documentoAnexoId   String?           @map("documento_anexo_id")
  documentoAnexo     DocumentoAnexo?   @relation(fields: [documentoAnexoId], references: [id])

  @@index([usuarioId])
  @@index([tipoAssinaturaId])
  @@index([atendimentoLocalId])
  @@index([cadeiaCustodiaId])
  @@index([documentoAnexoId])
  @@index([dataHora])
  @@map("assinaturas")
}

// ============================================================================
// DOMÍNIO 9: AUDITORIA E LOGS
// ============================================================================

/// Registro de auditoria de todas as operações sensíveis (append-only)
model Auditoria {
  id            String        @id @default(uuid())
  acao          AcaoAuditoria
  entidade      String
  entidadeId    String?       @map("entidade_id")
  valorAnterior Json?         @map("valor_anterior")
  valorNovo     Json?         @map("valor_novo")
  ipOrigem      String?       @map("ip_origem")
  userAgent     String?       @map("user_agent")
  dataHora      DateTime      @default(now()) @map("data_hora")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  dispositivoId String?      @map("dispositivo_id")
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id])

  @@index([usuarioId])
  @@index([acao])
  @@index([entidade, entidadeId])
  @@index([dataHora])
  @@index([dispositivoId])
  @@map("auditorias")
}

/// Log técnico do sistema (erros, warnings, info)
model LogSistema {
  id       String   @id @default(uuid())
  nivel    NivelLog
  mensagem String
  contexto Json?
  origem   String?
  dataHora DateTime @default(now()) @map("data_hora")

  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([nivel])
  @@index([dataHora])
  @@index([usuarioId])
  @@map("logs_sistema")
}

/// Histórico de alterações em registros (versionamento com snapshots JSONB)
model HistoricoAlteracao {
  id          String   @id @default(uuid())
  entidade    String
  entidadeId  String   @map("entidade_id")
  dadosAntes  Json     @map("dados_antes")
  dadosDepois Json     @map("dados_depois")
  versao      Int
  motivo      String?
  dataHora    DateTime @default(now()) @map("data_hora")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  atendimentoLocalId String?           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal? @relation(fields: [atendimentoLocalId], references: [id])

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([dataHora])
  @@index([atendimentoLocalId])
  @@map("historico_alteracoes")
}

/// Evento da linha do tempo de um atendimento/ocorrência
model LinhaTempo {
  id        String   @id @default(uuid())
  evento    String
  descricao String?
  metadata  Json?
  dataHora  DateTime @default(now()) @map("data_hora")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ocorrenciaId String     @map("ocorrencia_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  atendimentoLocalId String?           @map("atendimento_local_id")
  atendimentoLocal   AtendimentoLocal? @relation(fields: [atendimentoLocalId], references: [id])

  @@index([ocorrenciaId])
  @@index([atendimentoLocalId])
  @@index([usuarioId])
  @@index([dataHora])
  @@map("linhas_tempo")
}

// ============================================================================
// DOMÍNIO 10: CONFIGURAÇÕES E INFRAESTRUTURA
// ============================================================================

/// Configurações do sistema (chave-valor com tipagem JSONB)
model Configuracao {
  id           String   @id @default(uuid())
  chave        String   @unique
  valor        Json
  descricao    String?
  tipo         String   @default("string")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes")
}

/// Dispositivo móvel autorizado a operar offline
model Dispositivo {
  id                 String    @id @default(uuid())
  deviceId           String    @unique @map("device_id")
  nome               String?
  modelo             String?
  sistemaOperacional String?   @map("sistema_operacional")
  versaoApp          String?   @map("versao_app")
  ultimoAcesso       DateTime? @map("ultimo_acesso")
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  sincronizacoesOffline SincronizacaoOffline[]
  auditorias            Auditoria[]

  @@index([usuarioId])
  @@index([deviceId])
  @@index([ativo])
  @@map("dispositivos")
}

/// Registro de sincronização de dados offline (pull ou push)
model SincronizacaoOffline {
  id                  String              @id @default(uuid())
  tipo                String
  dataInicio          DateTime            @map("data_inicio")
  dataFim             DateTime?           @map("data_fim")
  status              StatusSincronizacao
  registrosEnviados   Int                 @default(0) @map("registros_enviados")
  registrosRecebidos  Int                 @default(0) @map("registros_recebidos")
  conflitosDetectados Int                 @default(0) @map("conflitos_detectados")
  criadoEm            DateTime            @default(now()) @map("criado_em")

  dispositivoId String      @map("dispositivo_id")
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id])

  filaSincronizacao FilaSincronizacao[]

  @@index([dispositivoId])
  @@index([status])
  @@index([dataInicio])
  @@map("sincronizacao_offline")
}

/// Fila de operações pendentes de sincronização
model FilaSincronizacao {
  id              String              @id @default(uuid())
  entidade        String
  entidadeId      String              @map("entidade_id")
  acao            String
  dados           Json
  dataOperacao    DateTime            @map("data_operacao")
  status          StatusSincronizacao @default(PENDENTE)
  tentativas      Int                 @default(0)
  ultimaTentativa DateTime?           @map("ultima_tentativa")
  mensagemErro    String?             @map("mensagem_erro")
  criadoEm        DateTime            @default(now()) @map("criado_em")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  sincronizacaoOfflineId String?               @map("sincronizacao_offline_id")
  sincronizacaoOffline   SincronizacaoOffline? @relation(fields: [sincronizacaoOfflineId], references: [id])

  @@index([usuarioId, status])
  @@index([status])
  @@index([sincronizacaoOfflineId])
  @@map("fila_sincronizacao")
}

/// Metadados de backups realizados
model BackupRegistro {
  id                 String    @id @default(uuid())
  tipo               String
  tamanhoBytes       Int?      @map("tamanho_bytes")
  localArmazenamento String?   @map("local_armazenamento")
  hashValidacao      String?   @map("hash_validacao")
  status             String    @default("concluido")
  observacoes        String?
  dataInicio         DateTime  @map("data_inicio")
  dataFim            DateTime? @map("data_fim")
  criadoEm           DateTime  @default(now()) @map("criado_em")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([dataInicio])
  @@index([status])
  @@map("backups_registro")
}
