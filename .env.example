# ============================================
# Configurações Gerais
# ============================================
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1

# ============================================
# Banco de Dados (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pcpe_crime_scene?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pcpe_crime_scene
POSTGRES_PORT=5432

# ============================================
# JWT
# ============================================
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# PgAdmin (Docker)
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@pcpe.pe.gov.br
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================
# Upload de imagens
MAX_IMAGE_UPLOAD_MB=10
STORAGE_PATH=./uploads
STORAGE_BASE_URL=http://localhost:3000/api/v1/files

# Frontend
# ============================================
FLUTTER_API_BASE_URL=http://localhost:3000/api/v1